{
  "expo": {
    "name": "Dotinout",
    "slug": "dotinout",
    "owner": "dotinouts-team",
    "scheme": "dotinout",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "backgroundColor": "#4F46E5",
    "ios": {
      "bundleIdentifier": "com.dotinout.app",
      "buildNumber": "1000",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.dotinout.app",
      "versionCode": 1000,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-mark.png",
          "imageWidth": 200,
          "backgroundColor": "#4F46E5"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Dotinout uses the camera to take your attendance photo when you punch in or out."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Dotinout uses your location to confirm you are at your work location when you punch."
        }
      ]
    ]
  }
}
