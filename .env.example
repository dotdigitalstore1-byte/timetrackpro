# PostgreSQL connection string (Neon, Supabase Postgres, RDS, self-hosted ...)
# For serverless hosting (Vercel) use your provider's *pooled* connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Platform owner (Super Admin). These credentials are checked on every sign-in, so editing them here
# takes effect on the next login with no seed step or database update.
SUPER_ADMIN_EMAIL=owner@yourcompany.com
# Use a strong password (12+ characters).
SUPER_ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional: max Postgres connections per server instance (default 10)
# DB_POOL_MAX=10

# Secret for the scheduled photo-retention job: POST /api/maintenance/purge-photos with "Authorization: Bearer <CRON_SECRET>"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Payments (Razorpay). Replace the placeholders with your test or live keys from the Razorpay dashboard.
# Until real keys are set, checkout stays hidden and nothing is sent to Razorpay.
# PAYMENT_PROVIDER=razorpay
# RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY
# RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET
# Secret used to sign webhooks (set the same value in the Razorpay dashboard webhook settings).
# RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET
# Public URL of this app, used for return links.
# APP_URL=https://your-domain.example


# ---------- RAZORPAY ----------
