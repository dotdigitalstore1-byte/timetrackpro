# PostgreSQL connection string (Neon, Supabase Postgres, RDS, self-hosted ...)
# For serverless hosting (Vercel) use your provider's *pooled* connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Platform owner (Super Admin). These credentials are checked on every sign-in, so editing them here
# takes effect on the next login with no seed step or database update.
SUPER_ADMIN_EMAIL=owner@yourcompany.com
# Use a strong password (12+ characters).
SUPER_ADMIN_PASSWORD=change-me-to-a-strong-password

# Optional: max Postgres connections per server instance (default 10)
# DB_POOL_MAX=10

# Secret for the scheduled photo-retention job: POST /api/maintenance/purge-photos with "Authorization: Bearer <CRON_SECRET>"
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=change-me-to-a-long-random-string
